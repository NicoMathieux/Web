document.id%2C+%22aQ-G0BEAACIAdfHh%22%29+%5D%5D",[150,151],"cotedivoire","Taï","2025-11-08T18:10:49+0000","2026-05-05T09:10:20+0000",[145],[],[],{"title":158,"date":159,"place":160,"gpx_file":161,"gpx_color":5,"youtube_link":167,"slices":170,"meta_title":282,"meta_description":283,"meta_image":284},"Hana","2022-11-08","Côte d'Ivoire",{"link_type":66,"key":162,"kind":68,"id":163,"url":164,"name":165,"size":166},"7d76a91d-b32b-4ae6-9774-ed60feede66a","aQ-G-LpReVYa4Q9t","https:\u002F\u002Fnico-mathieux.cdn.prismic.io\u002Fnico-mathieux\u002FaQ-G-LpReVYa4Q9t_hana.gpx","hana.gpx","401302",{"link_type":32,"key":168,"url":169,"target":35},"20cd0416-625b-4ae4-a35e-a35a01e476cc","https:\u002F\u002Fwww.youtube.com\u002Fwatch?v=PLavnEML3uM",[171,184,208,230,245,255,274],{"variation":101,"version":102,"items":172,"primary":173,"id":182,"slice_type":183,"slice_label":5},[],{"numbers":174,"shop_related":18},[175,178],{"number":176,"unit":5,"description":177},"7","Jours",{"number":179,"unit":180,"description":181},"60","km","Distance","numbers_list$3dc07c4c-8c54-4a98-bac0-4b5f473162d4","numbers_list",{"variation":101,"version":102,"items":185,"primary":186,"id":206,"slice_type":207,"slice_label":5},[],{"title":187,"subtitle":188,"text":189,"link":194,"image":198,"image_place":160,"image_date":205,"inverted":18,"shop_related":18},"À propos","01",[190],{"type":191,"text":192,"spans":193,"direction":79},"paragraph","Je traverse la rivière Hana en kayak, seul. La Hana est un cours d’eau qui traverse la forêt de Taï et qui joue un rôle important dans son fonctionnement. Son débit est relativement régulier, ce qui permet la navigation sur certaines portions. La largeur de la rivière varie selon les zones, avec des passages calmes et d’autres plus étroits. En avançant sur la Hana, je constate que ses rives sont bordées d’une végétation dense. La rivière constitue une source d’eau essentielle pour la forêt de Taï et contribue au maintien de l’humidité des sols. Elle influence également la répartition des espèces végétales et animales présentes le long de son cours. Le mont Nienokoué, qui se dresse non loin de la rivière, est un repère géographique important. Il influence localement le réseau hydrographique et participe à la diversité des paysages de la forêt. La Hana sert aussi de voie naturelle à l’intérieur de la forêt. En la traversant en solitaire, je suis son tracé qui relie différentes zones de la forêt de Taï. Cette traversée marque le début d’une relation directe entre moi et cet environnement, à partir de la rivière qui en est l’un des éléments centraux.",[],{"link_type":195,"key":196,"text":197},"Any","5a952a30-606e-44a7-ad18-90fd8406c126","Découvrir",{"dimensions":199,"alt":5,"copyright":5,"url":202,"id":203,"edit":204},{"width":200,"height":201},4032,3024,"https:\u002F\u002Fimages.prismic.io\u002Fnico-mathieux\u002FaWOHqgIvOtkhBRH-_IMG_8830.jpeg?auto=format,compress","aWOHqgIvOtkhBRH-",{"x":28,"y":28,"zoom":29,"background":30},"2022-07-14","title_text_image$aea1b051-0eba-4589-9c65-6a1e116b7e7e","title_text_image",{"variation":101,"version":102,"items":209,"primary":210,"id":228,"slice_type":229,"slice_label":5},[],{"images":211,"shop_related":18},[212,220],{"image":213,"place":160,"date":205},{"dimensions":214,"alt":5,"copyright":5,"url":217,"id":218,"edit":219},{"width":215,"height":216},1440,811,"https:\u002F\u002Fimages.prismic.io\u002Fnico-mathieux\u002FaWOH5wIvOtkhBRI1_950400FD-E5B6-4F53-8B3E-C43D0932DE21.jpg?auto=format,compress","aWOH5wIvOtkhBRI1",{"x":28,"y":28,"zoom":29,"background":30},{"image":221,"place":160,"date":205},{"dimensions":222,"alt":5,"copyright":5,"url":225,"id":226,"edit":227},{"width":223,"height":224},3840,2160,"https:\u002F\u002Fimages.prismic.io\u002Fnico-mathieux\u002FaWOHrQIvOtkhBRID_IMG_9686.JPG?auto=format,compress","aWOHrQIvOtkhBRID",{"x":28,"y":28,"zoom":29,"background":30},"image_carousel$55ca2ce9-2d09-4951-a911-675ca2b55013","image_carousel",{"variation":101,"version":102,"items":231,"primary":232,"id