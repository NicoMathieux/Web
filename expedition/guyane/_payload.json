nguages":217,"data":218},"aQjxxhMAACMAYb26","guyane","\u002Fexpedition\u002Fguyane","expedition","https:\u002F\u002Fnico-mathieux.cdn.prismic.io\u002Fapi\u002Fv2\u002Fdocuments\u002Fsearch?ref=afw_KhAAACIAZcuA&q=%5B%5B%3Ad+%3D+at%28document.id%2C+%22aQjxxhMAACMAYb26%22%29+%5D%5D",[210,211],"Amazonie","Guyane","2025-11-03T18:45:24+0000","2026-01-28T16:08:06+0000",[215],"petit-saut---cacao",[],[],{"title":219,"date":220,"place":211,"gpx_file":221,"gpx_color":5,"youtube_link":227,"slices":230,"meta_title":374,"meta_description":375,"meta_image":376},"Petit Saut - Cacao","2021-08-05",{"link_type":66,"key":222,"kind":68,"id":223,"url":224,"name":225,"size":226},"26bb3d49-0555-4fb8-b2b6-17f2d4165721","aQj2u7pReVYa394X","https:\u002F\u002Fnico-mathieux.cdn.prismic.io\u002Fnico-mathieux\u002FaQj2u7pReVYa394X_petit-saut-cacao.gpx","petit-saut-cacao.gpx","785099",{"link_type":32,"key":228,"url":229,"target":35},"20cd0416-625b-4ae4-a35e-a35a01e476cc","https:\u002F\u002Fwww.youtube.com\u002Fwatch?v=RM7ckMkpgts&list=PLUMQt0tV0hJqotMQ0y_rm9uz0OFhQ8Yz8&index=3",[231,252,305,311,328,338,356,365],{"variation":163,"version":164,"items":232,"primary":233,"id":250,"slice_type":251,"slice_label":5},[],{"numbers":234,"shop_related":18},[235,238,242,246],{"number":236,"unit":5,"description":237},"13","Jours",{"number":239,"unit":240,"description":241},"199","km","Distance",{"number":243,"unit":244,"description":245},"4120","D+","Dénivelé",{"number":247,"unit":248,"description":249},"33","°C","Température","numbers_list$3dc07c4c-8c54-4a98-bac0-4b5f473162d4","numbers_list",{"variation":163,"version":164,"items":253,"primary":254,"id":303,"slice_type":304,"slice_label":5},[],{"title":255,"subtitle":256,"text":257,"link":293,"image":297,"image_place":211,"image_date":220,"inverted":18,"shop_related":18},"À propos","01",[258,262,265,268,270,273,275,278,280,283,285,288,290],{"type":259,"text":260,"spans":261,"direction":79},"paragraph","Au départ du Lac de Petit Saut, en plein cœur de la forêt guyanaise, commence une remontée sauvage sur les eaux profondes et mystérieuses du Sinnamary. La progression se fait lentement, au fil des méandres, entre les troncs noyés et les rives couvertes d’une végétation dense.",[],{"type":259,"text":263,"spans":264,"direction":79},"",[],{"type":259,"text":266,"spans":267,"direction":79},"Le silence n’est troublé que par le bourdonnement des insectes, les cris des singes hurleurs",[],{"type":259,"text":263,"spans":269,"direction":79},[],{"type":259,"text":271,"spans":272,"direction":79},"Après plusieurs jours d’effort, je m’arrête juste avant le saut Deux Roros, l’un des passages les plus reculés du haut Sinnamary.",[],{"type":259,"text":263,"spans":274,"direction":79},[],{"type":259,"text":276,"spans":277,"direction":79},"L’expédition se poursuit alors par une traversée terrestre à travers la forêt primaire, reliant le bassin du Sinnamary à la Crique Grand Galibi plus à l’Ouest.",[],{"type":259,"text":263,"spans":279,"direction":79},[],{"type":259,"text":281,"spans":282,"direction":79},"Au terme de cette traversée, la descente du Comté ramène peu à peu à la civilisation, jusqu’au village de Cacao, fondé par la communauté hmong, où la rivière s’élargit et la vie humaine réapparaît.",[],{"type":259,"text":263,"spans":284,"direction":79},[],{"type":259,"text":286,"spans":287,"direction":79},"Cette aventure, reliant deux bassins versants majeurs de Guyane, trace une diagonale à travers une des zones les plus sauvages du territoire !",[],{"type":259,"text":263,"spans":289,"direction":79},[],{"type":259,"text":291,"spans":292,"direction":79},"Un itinéraire mêlant exploration, navigation et immersion totale dans l’Amazonie française.",[],{"link_type":294,"key":295,"text":296},"Any","5a952a30-606e-44a7-ad18-90fd8406c126","Découvrir",{"dimensions":298,"alt":5,"copyright":5,"url":300,"id":301,"edit":302},{"width":299,"height":299},512,"https:\u002F\u002Fimages.prismic.io\u002Fnico-mathieux\u002FaQ97C7pReVYa4Q9B_IMG_2542.HEIC?auto=for