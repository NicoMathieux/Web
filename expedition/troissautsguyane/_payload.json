218,"data":219},"aQ-N0xEAACMAdfw5","troissautsguyane","\u002Fexpedition\u002Ftroissautsguyane","expedition","https:\u002F\u002Fnico-mathieux.cdn.prismic.io\u002Fapi\u002Fv2\u002Fdocuments\u002Fsearch?ref=afqBqBAAACIAYuAP&q=%5B%5B%3Ad+%3D+at%28document.id%2C+%22aQ-N0xEAACMAdfw5%22%29+%5D%5D",[211,212],"Amazonie ","Guyane","2025-11-08T18:41:19+0000","2026-02-08T01:30:56+0000",[216],"trois-sauts---elahe",[],[],{"title":220,"date":221,"place":212,"gpx_file":222,"gpx_color":228,"youtube_link":229,"slices":232,"meta_title":369,"meta_description":370,"meta_image":371},"Trois Sauts - Elahe","2024-10-11",{"link_type":66,"key":223,"kind":68,"id":224,"url":225,"name":226,"size":227},"e22f80c2-bf6f-4e5c-b253-a6d11914582e","aQ-OA7pReVYa4Q-I","https:\u002F\u002Fnico-mathieux.cdn.prismic.io\u002Fnico-mathieux\u002FaQ-OA7pReVYa4Q-I_Exped.gpx","Exped.gpx","13821318","#FFFFFF",{"link_type":32,"key":230,"url":231,"target":35},"20cd0416-625b-4ae4-a35e-a35a01e476cc","https:\u002F\u002Fwww.youtube.com\u002Fwatch?v=qI_S0ztKphg",[233,246,274,305,315,333,342,351,360],{"variation":101,"version":102,"items":234,"primary":235,"id":244,"slice_type":245,"slice_label":5},[],{"numbers":236,"shop_related":18},[237,240],{"number":238,"unit":5,"description":239},"25","Jours",{"number":241,"unit":242,"description":243},"380","km","Distance","numbers_list$3dc07c4c-8c54-4a98-bac0-4b5f473162d4","numbers_list",{"variation":101,"version":102,"items":247,"primary":248,"id":272,"slice_type":273,"slice_label":5},[],{"title":249,"subtitle":220,"text":250,"link":261,"image":265,"image_place":212,"image_date":221,"inverted":18,"shop_related":18},"À propos",[251,255,258],{"type":252,"text":253,"spans":254,"direction":79},"paragraph","Aux confins de la Guyane française, le village amérindien de Trois Sauts, dernier bastion habité sur le haut Oyapock, a été le point de départ d’une expédition d’un mois à travers le Sud guyanais, d’est en ouest, jusqu’à Élahe, à la frontière du Suriname. En duo, les explorateurs ont suivi une ligne invisible reliant les monts Saint-Marcel, Belvédère et Cacao, avant de franchir la roche Péon et d’atteindre la source du Tampok.",[],{"type":252,"text":256,"spans":257,"direction":79},"Cette traversée fut marquée par la découverte d’une faune et d’une flore préservées, d’une nature authentique et encore largement méconnue. Le parcours a également révélé les traces d’anciennes civilisations, témoins silencieux du passé, à travers polissoirs et fragments de poteries dissimulés dans la forêt.",[],{"type":252,"text":259,"spans":260,"direction":79},"À la fois humaine et scientifique, cette aventure n’aurait pu voir le jour sans le soutien du Parc Amazonien de Guyane (PAG), dont l’engagement pour la connaissance et la préservation de ces territoires d’exception rend possible l’exploration respectueuse des dernières terres inexplorées de France.",[],{"link_type":262,"key":263,"text":264},"Any","5a952a30-606e-44a7-ad18-90fd8406c126","Découvrir",{"dimensions":266,"alt":5,"copyright":5,"url":269,"id":270,"edit":271},{"width":267,"height":268},2832,4240,"https:\u002F\u002Fimages.prismic.io\u002Fnico-mathieux\u002FaQhzdbpReVYa38GE_DSC06949.jpg?auto=format,compress","aQhzdbpReVYa38GE",{"x":28,"y":28,"zoom":29,"background":30},"title_text_image$aea1b051-0eba-4589-9c65-6a1e116b7e7e","title_text_image",{"variation":101,"version":102,"items":275,"primary":276,"id":303,"slice_type":304,"slice_label":5},[],{"images":277,"shop_related":18},[278,287,294],{"image":279,"place":286,"date":221},{"dimensions":280,"alt":5,"copyright":5,"url":283,"id":284,"edit":285},{"width":281,"height":282},10830,6092,"https:\u002F\u002Fimages.prismic.io\u002Fnico-mathieux\u002FaQh3aLpReVYa38LB_MontBelved%C3%A8re.jpg?auto=format,compress","aQh3aLpReVYa38LB",{"x":28,"y":28,"zoom":29,"background":30},"Mont Belvedère",{"image":288,"place":293,"date":221},{"dimensions":289,"alt":5,"copyright":5,"url":290,"id":291,"edit":292},{"width":268,"height":267},"https:\u002F\u002Fimages.prismic.io\u002F