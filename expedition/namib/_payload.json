218},"aQjOZRMAACEAYXY6","namib","\u002Fexpedition\u002Fnamib","expedition","https:\u002F\u002Fnico-mathieux.cdn.prismic.io\u002Fapi\u002Fv2\u002Fdocuments\u002Fsearch?ref=afsz0hAAAPzZZBPY&q=%5B%5B%3Ad+%3D+at%28document.id%2C+%22aQjOZRMAACEAYXY6%22%29+%5D%5D",[211],"Désert du Namib","2025-11-03T17:39:12+0000","2026-05-05T09:07:24+0000",[215],"desert-du-namib",[],[],{"title":211,"date":219,"place":220,"gpx_file":221,"gpx_color":5,"youtube_link":227,"slices":230,"meta_title":337,"meta_description":338,"meta_image":339},"2023-03-14","Namibie",{"link_type":66,"key":222,"kind":68,"id":223,"url":224,"name":225,"size":226},"2500b53f-7996-42c4-a0a5-8867e1bfd3b9","aQjtHbpReVYa391_","https:\u002F\u002Fnico-mathieux.cdn.prismic.io\u002Fnico-mathieux\u002FaQjtHbpReVYa391__namib-desert.gpx","namib-desert.gpx","165168",{"link_type":32,"key":228,"url":229,"target":35},"20cd0416-625b-4ae4-a35e-a35a01e476cc","https:\u002F\u002Fwww.youtube.com\u002Fwatch?v=v2lBYFO0y4Q",[231,252,279,293,308,318],{"variation":101,"version":102,"items":232,"primary":233,"id":250,"slice_type":251,"slice_label":5},[],{"numbers":234,"shop_related":18},[235,238,242,246],{"number":236,"unit":5,"description":237},"5","Jours",{"number":239,"unit":240,"description":241},"59","km","Distance",{"number":243,"unit":244,"description":245},"2340","D+","Dénivelé",{"number":247,"unit":248,"description":249},"47","°C","Température","numbers_list$3dc07c4c-8c54-4a98-bac0-4b5f473162d4","numbers_list",{"variation":101,"version":102,"items":253,"primary":254,"id":277,"slice_type":278,"slice_label":5},[],{"title":255,"subtitle":256,"text":257,"link":266,"image":270,"image_place":220,"image_date":219,"inverted":18,"shop_related":18},"À propos","01",[258],{"type":259,"text":260,"spans":261,"direction":79},"paragraph","Le désert du Namib, vieux de plus de 55 millions d’années, est le plus ancien désert du monde. S’étendant sur la côte atlantique de la Namibie, il se caractérise par un climat d’extrêmes : moins de 10 mm de pluie par an, des écarts de température vertigineux et une brume côtière vitale générée par le courant froid de Benguela. Cette brume, source principale d’eau, permet à une biodiversité unique de survivre. La Welwitschia mirabilis, plante millénaire endémique, en est l’emblème. Le scarabée du brouillard, le gecko transparent ou l’oryx gazella témoignent d’adaptations spectaculaires à cet environnement implacable. Le Namib est ainsi un désert paradoxal : à la fois aride, ancien et pourtant foisonnant de vie.",[262],{"start":263,"end":264,"type":265},416,437,"em",{"link_type":267,"key":268,"text":269},"Any","5a952a30-606e-44a7-ad18-90fd8406c126","Découvrir",{"dimensions":271,"alt":5,"copyright":5,"url":274,"id":275,"edit":276},{"width":272,"height":273},2832,4240,"https:\u002F\u002Fimages.prismic.io\u002Fnico-mathieux\u002FaQjp4rpReVYa39zM_IMG_1321.JPG?auto=format,compress","aQjp4rpReVYa39zM",{"x":28,"y":28,"zoom":29,"background":30},"title_text_image$aea1b051-0eba-4589-9c65-6a1e116b7e7e","title_text_image",{"variation":101,"version":102,"items":280,"primary":281,"id":291,"slice_type":292,"slice_label":5},[],{"images":282,"shop_related":18},[283],{"image":284,"place":220,"date":219},{"dimensions":285,"alt":5,"copyright":5,"url":288,"id":289,"edit":290},{"width":286,"height":287},5120,2700,"https:\u002F\u002Fimages.prismic.io\u002Fnico-mathieux\u002FaQjQLbpReVYa39VM_DJI_0037.MP4.00_00_04_15.Still001.JPG?auto=format,compress","aQjQLbpReVYa39VM",{"x":28,"y":28,"zoom":29,"background":30},"image_carousel$55ca2ce9-2d09-4951-a911-675ca2b55013","image_carousel",{"variation":101,"version":102,"items":294,"primary":295,"id":306,"slice_type":307,"slice_label":5},[],{"left_image":296,"right_image":301,"shop_related":18},{"dimensions":297,"alt":5,"copyright":5,"url":298,"id":299,"edit":300},{"width":272,"height":273},"https:\u002F\u002Fimages.prismic.io\u002Fnico-mathieux\u002FaQjbDbpReVYa39d8_IMG_1269.JPG?auto=format,compress","aQjbDbpReVYa39d8",{"x":28,"y":28,"zoom":29,"background":30}