":219},"aWOhDRIAACcAOVi1","oyapock","\u002Fexpedition\u002Foyapock","expedition","https:\u002F\u002Fnico-mathieux.cdn.prismic.io\u002Fapi\u002Fv2\u002Fdocuments\u002Fsearch?ref=afsp9BAAAPzZY_3R&q=%5B%5B%3Ad+%3D+at%28document.id%2C+%22aWOhDRIAACcAOVi1%22%29+%5D%5D",[211,212,213],"Amazonie","Guyane","Oyapock","2026-01-11T13:42:48+0000","2026-01-28T16:21:22+0000",[206],[],[],{"title":213,"date":220,"place":212,"gpx_file":221,"gpx_color":5,"youtube_link":227,"slices":230,"meta_title":346,"meta_description":347,"meta_image":348},"2023-05-13",{"link_type":66,"key":222,"kind":68,"id":223,"url":224,"name":225,"size":226},"5da2055d-2de6-4e91-9e51-eeb6a720a2c8","aWOkYgIvOtkhBRO8","https:\u002F\u002Fnico-mathieux.cdn.prismic.io\u002Fnico-mathieux\u002FaWOkYgIvOtkhBRO8_oyapock.gpx","oyapock.gpx","450180",{"link_type":32,"key":228,"url":229,"target":35},"20cd0416-625b-4ae4-a35e-a35a01e476cc","https:\u002F\u002Fwww.youtube.com\u002Fwatch?v=nhcxBRiQjQs&t=2383s",[231,252,278,301,318,328],{"variation":101,"version":102,"items":232,"primary":233,"id":250,"slice_type":251,"slice_label":5},[],{"numbers":234,"shop_related":18},[235,238,242,246],{"number":236,"unit":5,"description":237},"8","Jours",{"number":239,"unit":240,"description":241},"125","km","Distance",{"number":243,"unit":244,"description":245},"2014","D+","Dénivelé",{"number":247,"unit":248,"description":249},"33","°C","Température","numbers_list$3dc07c4c-8c54-4a98-bac0-4b5f473162d4","numbers_list",{"variation":101,"version":102,"items":253,"primary":254,"id":276,"slice_type":277,"slice_label":5},[],{"title":255,"subtitle":256,"text":257,"link":262,"image":266,"image_place":212,"image_date":220,"inverted":18,"shop_related":18},"À propos","01",[258],{"type":259,"text":260,"spans":261,"direction":79},"paragraph","Nous descendons la rivière Oyapock depuis le village de Camopi jusqu’à Saint-Georges en packraft, à deux, sans aucun ravitaillement. L’objectif est simple mais exigeant : se nourrir uniquement de ce que nous trouvons sur place, poissons et fruits de la forêt. La rivière est large et rapide par endroits, parsemée de troncs immergés et de bancs de sable qu’il faut contourner à chaque coup de pagaie. Les paysages changent constamment : forêt dense, plages de sable, méandres étroits et zones ouvertes où la végétation s’éclaircit. Les rapides imposent un rythme soutenu et une vigilance constante. Nous pêchons dès que possible, et nous arrêtons parfois pour récolter des fruits ou vérifier les pièges improvisés, chaque ressource trouvée devenant vitale. L’Oyapock reste une voie exigeante mais essentielle. Elle trace notre progression à travers le Brésil et la Guyane, et impose son rythme : chaque rapide franchi et chaque portion calme parcourue rappelle l’importance de rester concentrés. La fatigue s’installe vite, mais la satisfaction de vivre de ce que la forêt et la rivière offrent rend l’expédition intense et unique.",[],{"link_type":263,"key":264,"text":265},"Any","5a952a30-606e-44a7-ad18-90fd8406c126","Découvrir",{"dimensions":267,"alt":5,"copyright":5,"url":270,"id":271,"edit":272},{"width":268,"height":269},4240,2832,"https:\u002F\u002Fimages.prismic.io\u002Fnico-mathieux\u002FaWOn_wIvOtkhBRPc_DSC00881.JPG?auto=format%2Ccompress&rect=1539%2C183%2C2701%2C1804&w=4240&h=2832","aWOn_wIvOtkhBRPc",{"x":273,"y":274,"zoom":275,"background":30},1539,183,1.57,"title_text_image$aea1b051-0eba-4589-9c65-6a1e116b7e7e","title_text_image",{"variation":101,"version":102,"items":279,"primary":280,"id":299,"slice_type":300,"slice_label":5},[],{"images":281,"shop_related":18},[282,288,294],{"image":283,"place":211,"date":220},{"dimensions":284,"alt":5,"copyright":5,"url":285,"id":286,"edit":287},{"width":268,"height":269},"https:\u002F\u002Fimages.prismic.io\u002Fnico-mathieux\u002FaWOoBgIvOtkhBRPe_DSC00944.JPG?auto=format,compress","aWOoBgIvOtkhBRPe",{"x":28,"y":28,"zoom":29,"background":30},{"image":289,"place":212,"date":220},{"dimensions":290,"alt":5,"copyright":5,"url":291,"id":292,"edit":293