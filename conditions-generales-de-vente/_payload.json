},{"link_type":32,"key":53,"url":54,"target":35},"b5f138b6-e91d-4b37-ba8c-d9929cddb4d5","https:\u002F\u002Fwww.tiktok.com\u002F@nico.mathieux",{"logo":56,"link":62},{"dimensions":57,"alt":5,"copyright":5,"url":59,"id":60,"edit":61},{"width":58,"height":24},84,"https:\u002F\u002Fimages.prismic.io\u002Fnico-mathieux\u002FZ_lRSuvxEdbNO8J5_twitter.png?auto=format,compress","Z_lRSuvxEdbNO8J5",{"x":28,"y":28,"zoom":29,"background":30},{"link_type":32,"key":63,"url":64,"target":35},"52e3c556-fb15-49aa-ad36-754e6476ff5a","https:\u002F\u002Fx.com\u002FNicoMathieux",{"link_type":66,"key":67,"kind":68,"id":69,"url":70,"name":71,"size":72},"Media","5972c34b-24c7-4f55-b332-a4e3034e923a","file","aWN51wIvOtkhBQik","https:\u002F\u002Fnico-mathieux.cdn.prismic.io\u002Fnico-mathieux\u002FaWN51wIvOtkhBQik_jungle.mp3","jungle.mp3","601485","645238e0-17b5-4df6-9908-9e27994f447d",[75],{"type":76,"text":77,"spans":78,"direction":79},"preformatted","{\"speed\":2,\"force\":5,\"size\":0.2,\"alpha\":1,\"color1\":{\"r\":0.35,\"g\":0.27,\"b\":0.18},\"color1f\":[0.35,0.27,0.18],\"color2\":{\"r\":0.9,\"g\":0.66,\"b\":0.42},\"color2f\":[0.9,0.66,0.42],\"grainForce\":5,\"grainSize\":0.1,\"grainSpeed\":0}",[],"ltr",{"id":81,"uid":5,"url":5,"type":82,"href":83,"tags":84,"first_publication_date":85,"last_publication_date":86,"slugs":87,"linked_documents":88,"lang":14,"alternate_languages":89,"data":90},"Z_lPcREAAC0An_F2","menu","https:\u002F\u002Fnico-mathieux.cdn.prismic.io\u002Fapi\u002Fv2\u002Fdocuments\u002Fsearch?ref=afxAOBAAACIAZc27&q=%5B%5B%3Ad+%3D+at%28document.id%2C+%22Z_lPcREAAC0An_F2%22%29+%5D%5D",[],"2025-04-11T17:20:54+0000","2026-05-05T09:15:11+0000",[82],[],[],{"show_cart":91,"show_contact":91,"show_social_medias":91,"image":92,"slices":99},true,{"dimensions":93,"alt":5,"copyright":5,"url":96,"id":97,"edit":98},{"width":94,"height":95},750,1050,"https:\u002F\u002Fimages.prismic.io\u002Fnico-mathieux\u002FZ_lPKuvxEdbNO8F1_fc0bd4fd283590fb2a58b1fa5296dc69.png?auto=format,compress","Z_lPKu