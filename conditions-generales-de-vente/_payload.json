anguages":208,"data":209},"https:\u002F\u002Fnico-mathieux.cdn.prismic.io\u002Fapi\u002Fv2\u002Fdocuments\u002Fsearch?ref=afxAOBAAACIAZc27&q=%5B%5B%3Ad+%3D+at%28document.id%2C+%22aGOpSBAAACkAKmEP%22%29+%5D%5D",[],[197],[],[],{"slices":210,"meta_title":5,"meta_description":5,"meta_image":1178},[211],{"variation":101,"version":102,"items":212,"primary":213,"id":1176,"slice_type":1177,"slice_label":5},[],{"title":202,"text":214,"shop_related":18},[215,222,225,228,231,234,237,242,245,248,251,254,257,260,263,266,271,274,277,280,283,286,289,292,295,300,303,306,309,312,315,318,321,324,329,332,335,338,343,346,349,352,355,358,361,364,367,370,373,375,378,383,386,389,392,395,398,401,404,407,410,413,416,419,422,425,428,431,434,437,439,442,445,448,451,454,457,460,464,467,470,473,476,479,482,485,488,491,494,497,500,503,506,509,512,515,518,521,524,527,531,534,537,540,543,546,549,552,555,558,561,564,569,572,575,578,581,584,587,590,593,596,599,602,605,608,611,614,617,620,624,627,630,633,636,641,644,647,650,653,656,659,662,665,668,671,675,678,681,684,687,690,693,696,699,702,705,708,711,714,717,720,723,726,731,734,737,740,743,746,749,752,755,758,761,766,769,772,775,778,781,784,787,790,793,796,799,802,805,808,811,814,817,820,823,826,829,832,836,839,842,845,848,851,854,859,862,865,868,871,875,878,881,884,887,890,893,896,899,902,905,908,911,914,917,920,923,926,929,932,935,938,941,944,947,950,953,956,959,962,965,968,971,974,977,980,983,986,989,992,995,998,1001,1004,1007,1010,1013,1018,1021,1024,1027,1030,1033,1036,1039,1042,1045,1048,1051,1054,1057,1060,1063,1066,1069,1072,1075,1078,1081,1086,1089,1092,1095,1098,1101,1104,1107,1110,1113,1116,1119,1122,1125,1128,1131,1134,1137,1140,1143,1146,1149,1152,1157,1162,1165,1168,1171,1174],{"type":216,"text":217,"spans":218,"direction":79},"paragraph","Article 1 : Conditions d’application",[219],{"start":28,"end":220,"type":221},36,"strong",{"type":216,"text":223,"spans":224,"direction":79},"Les présentes conditions générales de",[],{"type":216,"text":226,"spans":227,"direction":79},"vente sont communiquées au plus tard",[],{"type":216,"text":229,"spans":230,"direction":79},"avec l’envoi de l’accord de réservation et",[],{"type":216,"text":232,"spans":233,"direction":79},"de la demande d’acompte ou de",[],{"type":216,"text":235,"spans":236,"direction":79},"règlement.",[],{"type":216,"text":238,"spans":239,"direction":79},"Article 2 : Prix",[240],{"start":28,"end":241,"type":221},16,{"type":216,"text":243,"spans":244,"direction":79},"Tous les prix et tarifs indiqués s’entendent",[],{"type":216,"text":246,"spans":247,"direction":79},"en euros (T.V.A. non applicable). Les prix",[],{"type":216,"text":249,"spans":250,"direction":79},"indiqués au moment de la réservation sont",[],{"type":216,"text":252,"spans":253,"direction":79},"fermes pour la durée de cette réservation",[],{"type":216,"text":255,"spans":256,"direction":79},"et ne peuvent faire l’objet de modifications",[],{"type":216,"text":258,"spans":259,"direction":79},"sauf exception décidée par Le Prestataire.",[],{"type":216,"text":261,"spans":262,"direction":79},"Le prix est confirmé à l’accord de",[],{"type":216,"text":264,"spans":265,"direction":79},"prestation",[],{"type":216,"text":267,"spans":268,"direction":79},"Article 3 : Formalités et mesures sanitaires",[269],{"start":28,"end":270,"type":221},12,{"type":216,"text":272,"spans":273,"direction":79},"Le Client est tenu de se conformer à la loi",[],{"type":216,"text":275,"spans":276,"direction":79},"et de prendre en charge les formalités",[],{"type":216,"text":278,"spans":279,"direction":79},"administratives le concernant. Le Client",[],{"type":216,"text":281,"spans":282,"direction":79},"est tenu de se conformer aux mesures",[],{"type":216,"text":284,"spans":285,"direction":79},"sanitaires en particulier en matière de",[],{"type":216,"text":287,"spans":288,"direction":79},"vaccinations. En cas de non-respect, la",[],{"type":216,"text":290,"spans":291,"direction":79},"responsabilité du Prestataire ne saurait",[],{"type":216,"text":293,"spans":294,"direction":79},"être engagée.",[],{"type":216,"text":296,"spans":297,"direction":79},"Article 4 : Réservations",[298],{"start":28,"end":299,"type":221},24,{"type":216,"text":301,"spans":302,"direction":79},"Toute prestation doit préalablement faire",[],{"type":216,"text":304,"spans":305,"direction":79},"l’objet d’une réservation. Un accord de",[],{"type":216,"text":307,"spans":308,"direction":79},"réservation avec demande d'acompte ou",[],{"type":216,"text":310,"spans":311,"direction":79},"de règlement total est envoyé au Client",[],{"type":216,"text":313,"spans":314,"direction":79},"par écrit. Une réservation est annulée en",[],{"type":216,"text":316,"spans":317,"direction":79},"cas de non versement de l'acompte ou du",[],{"type":216,"text":319,"spans":320,"direction":79},"règlement total selon les dispositions de",[],{"type":216,"text":322,"spans":323,"direction":79},"l’article 6.",[],{"type":216,"text":325,"spans":326,"direction":79},"Article 5 : Confirmation de prestation",[327],{"start":28,"end":328,"type":221},38,{"type":216,"text":330,"spans":331,"direction":79},"Une réservation doit faire l’objet d’un",[],{"type":216,"text":333,"spans":334,"direction":79},"accord du Prestataire à l’écrit pour que la",[],{"type":216,"text":336,"spans":337,"direction":79},"prestation soit confirmée.",[],{"type":216,"text":339,"spans":340,"direction":79},"Article 6 : Acompte et règlement",[341],{"start":28,"end":342,"type":221},32,{"type":216,"text":344,"spans":345,"direction":79},"Le montant de l’acompte demandé est le",[],{"type":216,"text":347,"spans":348,"direction":79},"suivant : 50% du montant total de la",[],{"type":216,"text":350,"spans":351,"direction":79},"prestation 30 jours minimum avant le",[],{"type":216,"text":353,"spans":354,"direction":79},"premier jour de la prestation qui a été",[],{"type":216,"text":356,"spans":357,"direction":79},"réservée. Le premier jour de la prestation",[],{"type":216,"text":359,"spans":360,"direction":79},"s’entend ainsi : jour de départ de",[],{"type":216,"text":362,"spans":363,"direction":79},"l’excursion ou jour de remise du matériel",[],{"type":216,"text":365,"spans":366,"direction":79},"de location. Le solde pour règlement total",[],{"type":216,"text":368,"spans":369,"direction":79},"du montant de la prestation doit être",[],{"type":216,"text":371,"spans":372,"direction":79},"effectué 10 jours minimum avant le",[],{"type":216,"text":353,"spans":374,"direction":79},[],{"type":216,"text":376,"spans":377,"direction":79},"réservée.",[],{"type":216,"text":379,"spans":380,"direction":79},"Article 7 : Caution",[381],{"start":28,"end":382,"type":221},19,{"type":216,"text":384,"spans":385,"direction":79},"Lorsque du matériel est prêté à titre",[],{"type":216,"text":387,"spans":388,"direction":79},"gracieux ou onéreux, Le Prestataire se",[],{"type":216,"text":390,"spans":391,"direction":79},"réserve le droit de demander un chèque",[],{"type":216,"text":393,"spans":394,"direction":79},"de caution.",[],{"type":216,"text":396,"spans":397,"direction":79},"En cas de détérioration partielle du",[],{"type":216,"text":399,"spans":400,"direction":79},"matériel prêté, le chèque de caution sera",[],{"type":216,"text":402,"spans":403,"direction":79},"restitué contre le paiement du montant",[],{"type":216,"text":405,"spans":406,"direction":79},"estimé des réparations et des frais",[],{"type":216,"text":408,"spans":409,"direction":79},"annexes, notamment les frais de",[],{"type":216,"text":411,"spans":412,"direction":79},"transports pour la réparation. A défaut le",[],{"type":216,"text":414,"spans":415,"direction":79},"chèque de caution sera encaissé.",[],{"type":216,"text":417,"spans":418,"direction":79},"En cas de perte, de vol ou de détérioration",[],{"type":216,"text":420,"spans":421,"direction":79},"du matériel telle que ce matériel est",[],{"type":216,"text":423,"spans":424,"direction":79},"irréparable ou que le prix de la réparation",[],{"type":216,"text":426,"spans":427,"direction":79},"excède celui du prix d’achat neuf, le",[],{"type":216,"text":429,"spans":430,"direction":79},"chèque de caution sera encaissé dans sa",[],{"type":216,"text":432,"spans":433,"direction":79},"totalité.",[],{"type":216,"text":435,"spans":436,"direction":79},"En cas de retard du Client à rendre le",[],{"type":216,"text":399,"spans":438,"direction":79},[],{"type":216,"text":440,"spans":441,"direction":79},"restitué contre le versement d’une pénalité",[],{"type":216,"text":443,"spans":444,"direction":79},"journalière égale au tarif journalier de",[],{"type":216,"text":446,"spans":447,"direction":79},"location dudit matériel. Dans le cas où ce",[],{"type":216,"text":449,"spans":450,"direction":79},"retard oblige Le Prestataire à annuler une",[],{"type":216,"text":452,"spans":453,"direction":79},"prestation déjà réservée, le montant total",[],{"type":216,"text":455,"spans":456,"direction":79},"de la prestation annulée est ajouté à la",[],{"type":216,"text":458,"spans":459,"direction":79},"pénalité journalière.",[],{"type":216,"text":461,"spans":462,"direction":79},"Article 8 : Annulation par le prestataire",[463],{"start":28,"end":270,"type":221},{"type":216,"text":465,"spans":466,"direction":79},"Le Prestataire peut annuler la prestation si",[],{"type":216,"text":468,"spans":469,"direction":79},"le nombre minimal de participants requis",[],{"type":216,"text":471,"spans":472,"direction":79},"n’est pas atteint. Ce minimum est précisé",[],{"type":216,"text":474,"spans":475,"direction":79},"sur le site internet",[],{"type":216,"text":477,"spans":478,"direction":79},"“www.nicomathieux.com”",[],{"type":216,"text":480,"spans":481,"direction":79},"Le Prestataire",[],{"type":216,"text":483,"spans":484,"direction":79},"tient à informer Le Client dans les",[],{"type":216,"text":486,"spans":487,"direction":79},"meilleurs délais si le nombre minimum de",[],{"type":216,"text":489,"spans":490,"direction":79},"réservations n’est pas atteint.",[],{"type":216,"text":492,"spans":493,"direction":79},"Toutefois les excursions sur mesure ainsi",[],{"type":216,"text":495,"spans":496,"direction":79},"que les locations de matériel ne sont pas",[],{"type":216,"text":498,"spans":499,"direction":79},"soumises à la contrainte d’un nombre",[],{"type":216,"text":501,"spans":502,"direction":79},"minimum de réservations.",[],{"type":216,"text":504,"spans":505,"direction":79},"En cas d’annulation de prestation à cause",[],{"type":216,"text":507,"spans":508,"direction":79},"d’un nombre trop faible de participants à",[],{"type":216,"text":510,"spans":511,"direction":79},"une excursion ou en cas de force majeur,",[],{"type":216,"text":513,"spans":514,"direction":79},"Le Prestataire peut proposer la même",[],{"type":216,"text":516,"spans":517,"direction":79},"prestation à une autre date, ou proposer",[],{"type":216,"text":519,"spans":520,"direction":79},"une prestation similaire, ou à la demande",[],{"type":216,"text":522,"spans":523,"direction":79},"du Client de rembourser les sommes",[],{"type":216,"text":525,"spans":526,"direction":79},"éventuellement déjà versées.",[],{"type":216,"text":528,"spans":529,"direction":79},"Article 9 : Annulation par le client",[530],{"start":28,"end":220,"type":221},{"type":216,"text":532,"spans":533,"direction":79},"Le premier jour de la prestation s’entend",[],{"type":216,"text":535,"spans":536,"direction":79},"ainsi : jour de départ de l’excursion ou jour",[],{"type":216,"text":538,"spans":539,"direction":79},"de remise du matériel de location.",[],{"type":216,"text":541,"spans":542,"direction":79},"Si une annulation intervient entre 31 et 11",[],{"type":216,"text":544,"spans":545,"direction":79},"jours non inclus avant le premier jour de la",[],{"type":216,"text":547,"spans":548,"direction":79},"prestation, l‘acompte versé est conservé",[],{"type":216,"text":550,"spans":551,"direction":79},"par Le Prestataire.",[],{"type":216,"text":553,"spans":554,"direction":79},"Si une annulation intervient moins de 11",[],{"type":216,"text":556,"spans":557,"direction":79},"jours avant le premier jour de la prestation,",[],{"type":216,"text":559,"spans":560,"direction":79},"le règlement total est conservé par Le",[],{"type":216,"text":562,"spans":563,"direction":79},"Prestataire.",[],{"type":216,"text":565,"spans":566,"direction":79},"Article 10 : Modifications",[567],{"start":28,"end":568,"type":221},26,{"type":216,"text":570,"spans":571,"direction":79},"Toute modification de la prestation devra",[],{"type":216,"text":573,"spans":574,"direction":79},"faire l’objet d’une demande écrite du Client",[],{"type":216,"text":576,"spans":577,"direction":79},"et d’un accord écrit du Prestataire.",[],{"type":216,"text":579,"spans":580,"direction":79},"Au cours de la prestation, les conditions",[],{"type":216,"text":582,"spans":583,"direction":79},"météorologiques, l'environnement, le",[],{"type":216,"text":585,"spans":586,"direction":79},"niveau d’eau dans les cours d’eau ou la",[],{"type":216,"text":588,"spans":589,"direction":79},"condition physique des participants",[],{"type":216,"text":591,"spans":592,"direction":79},"peuvent amener une modification du",[],{"type":216,"text":594,"spans":595,"direction":79},"programme établi.",[],{"type":216,"text":597,"spans":598,"direction":79},"Si au cours du séjour, des circonstances",[],{"type":216,"text":600,"spans":601,"direction":79},"impérieuses ou des événements imprévus",[],{"type":216,"text":603,"spans":604,"direction":79},"impliquant la sécurité des clients",[],{"type":216,"text":606,"spans":607,"direction":79},"l'imposent, Le Prestataire se réserve le",[],{"type":216,"text":609,"spans":610,"direction":79},"droit de modifier les dates, les horaires ou",[],{"type":216,"text":612,"spans":613,"direction":79},"l'itinéraire prévu sans que Le Client ne",[],{"type":216,"text":615,"spans":616,"direction":79},"puisse prétendre à une indemnité ou un",[],{"type":216,"text":618,"spans":619,"direction":79},"remboursement.",[],{"type":216,"text":621,"spans":622,"direction":79},"Article 11 : Facturation",[623],{"start":28,"end":299,"type":221},{"type":216,"text":625,"spans":626,"direction":79},"Les factures sont établies et doivent être",[],{"type":216,"text":628,"spans":629,"direction":79},"réglées en Euros. Les frais inhérents au",[],{"type":216,"text":631,"spans":632,"direction":79},"paiement (frais de virement, de change,",[],{"type":216,"text":634,"spans":635,"direction":79},"etc) sont à la charge du Client.",[],{"type":216,"text":637,"spans":638,"direction":79},"Article 12 : Cession de contrat",[639],{"start":28,"end":640,"type":221},31,{"type":216,"text":642,"spans":643,"direction":79},"Le client pourra céder son contrat à un",[],{"type":216,"text":645,"spans":646,"direction":79},"cessionnaire qui remplit les mêmes",[],{"type":216,"text":648,"spans":649,"direction":79},"conditions que lui à la condition d’en",[],{"type":216,"text":651,"spans":652,"direction":79},"informer et d’en obtenir l’accord du",[],{"type":216,"text":654,"spans":655,"direction":79},"Prestataire. En cas d’impossibilité de",[],{"type":216,"text":657,"spans":658,"direction":79},"quelque nature qu'elle soit, Le Prestataire",[],{"type":216,"text":660,"spans":661,"direction":79},"peut céder l’exécution de la prestation à",[],{"type":216,"text":663,"spans":664,"direction":79},"un autre guide qui remplit des conditions",[],{"type":216,"text":666,"spans":667,"direction":79},"similaires (expérience, forme physique,",[],{"type":216,"text":669,"spans":670,"direction":79},"etc).",[],{"type":216,"text":672,"spans":673,"direction":79},"Article 13 : Réclamation",[674],{"start":28,"end":299,"type":221},{"type":216,"text":676,"spans":677,"direction":79},"Au cas où Le Client contesterait l’absence",[],{"type":216,"text":679,"spans":680,"direction":79},"ou la mauvaise qualité d’une prestation, il",[],{"type":216,"text":682,"spans":683,"direction":79},"doit en informer Le Prestataire par écrit,",[],{"type":216,"text":685,"spans":686,"direction":79},"au plus tard dans les deux mois qui",[],{"type":216,"text":688,"spans":689,"direction":79},"suivent le dernier jour du séjour ou de la",[],{"type":216,"text":691,"spans":692,"direction":79},"location concerné par la réclamation,",[],{"type":216,"text":694,"spans":695,"direction":79},"accompagné des justificatifs.",[],{"type":216,"text":697,"spans":698,"direction":79},"Le Prestataire s’engage à mettre en",[],{"type":216,"text":700,"spans":701,"direction":79},"œuvre les moyens pour résoudre la",[],{"type":216,"text":703,"spans":704,"direction":79},"difficulté du Client.",[],{"type":216,"text":706,"spans":707,"direction":79},"Le matériel perdu, mouillé, cassé, mis",[],{"type":216,"text":709,"spans":710,"direction":79},"hors service quelques soient les",[],{"type":216,"text":712,"spans":713,"direction":79},"circonstances (pluies, naufrage, chutes,",[],{"type":216,"text":715,"spans":716,"direction":79},"écrasement, mauvaise manipulation ou",[],{"type":216,"text":718,"spans":719,"direction":79},"autre), ne pourra faire l’objet d’aucune",[],{"type":216,"text":721,"spans":722,"direction":79},"demande de remboursement ou de",[],{"type":216,"text":724,"spans":725,"direction":79},"réparation auprès du Prestataire.",[],{"type":216,"text":727,"spans":728,"direction":79},"Article 14 : Assurance",[729],{"start":28,"end":730,"type":221},22,{"type":216,"text":732,"spans":733,"direction":79},"Aucune assurance n’est incluse dans les",[],{"type":216,"text":735,"spans":736,"direction":79},"tarifs, sauf mention particulière. Il",[],{"type":216,"text":738,"spans":739,"direction":79},"appartient au Client de souscrire les",[],{"type":216,"text":741,"spans":742,"direction":79},"polices d’assurance adaptées à la nature",[],{"type":216,"text":744,"spans":745,"direction":79},"du séjour et des activités prévues",[],{"type":216,"text":747,"spans":748,"direction":79},"(notamment assurance annulation,",[],{"type":216,"text":750,"spans":751,"direction":79},"responsabilité civile, maladie et accident).",[],{"type":216,"text":753,"spans":754,"direction":79},"Le Prestataire a souscrit un contrat",[],{"type":216,"text":756,"spans":757,"direction":79},"garantissant sa responsabilité civile dans",[],{"type":216,"text":759,"spans":760,"direction":79},"le cadre de ses activités.",[],{"type":216,"text":762,"spans":763,"direction":79},"Article 15 : Droit à l’image",[764],{"start":28,"end":765,"type":221},28,{"type":216,"text":767,"spans":768,"direction":79},"Le Client donne son accord à la réalisation",[],{"type":216,"text":770,"spans":771,"direction":79},"de photographies, de vidéos ou de",[],{"type":216,"text":773,"spans":774,"direction":79},"captations numériques sur lesquelles il est",[],{"type":216,"text":776,"spans":777,"direction":79},"susceptible d’apparaître. Les images ainsi",[],{"type":216,"text":779,"spans":780,"direction":79},"collectées pourront être gracieusement",[],{"type":216,"text":782,"spans":783,"direction":79},"exploitées par Le Prestataire sous toute",[],{"type":216,"text":785,"spans":786,"direction":79},"forme et tous supports pour un territoire",[],{"type":216,"text":788,"spans":789,"direction":79},"illimité, sans limitation de durée,",[],{"type":216,"text":791,"spans":792,"direction":79},"intégralement ou par extraits et",[],{"type":216,"text":794,"spans":795,"direction":79},"notamment : site internet, réseaux",[],{"type":216,"text":797,"spans":798,"direction":79},"sociaux, etc.",[],{"type":216,"text":800,"spans":801,"direction":79},"Le Prestataire s’interdit expressément de",[],{"type":216,"text":803,"spans":804,"direction":79},"procéder à une exploitation des",[],{"type":216,"text":806,"spans":807,"direction":79},"photographies, des vidéos et des",[],{"type":216,"text":809,"spans":810,"direction":79},"captations numériques susceptibles de",[],{"type":216,"text":812,"spans":813,"direction":79},"porter atteinte à la réputation du Client ou",[],{"type":216,"text":815,"spans":816,"direction":79},"à la vie privée du Client.",[],{"type":216,"text":818,"spans":819,"direction":79},"Sur demande écrite de la part du Client,",[],{"type":216,"text":821,"spans":822,"direction":79},"Le Prestataire s’interdit toute exploitation",[],{"type":216,"text":824,"spans":825,"direction":79},"des photographies, des vidéos et des",[],{"type":216,"text":827,"spans":828,"direction":79},"captations numériques sur lesquelles Le",[],{"type":216,"text":830,"spans":831,"direction":79},"Client est présent.",[],{"type":216,"text":833,"spans":834,"direction":79},"Article 16 : Transports.",[835],{"start":28,"end":299,"type":221},{"type":216,"text":837,"spans":838,"direction":79},"Les transports jusqu’aux lieux de",[],{"type":216,"text":840,"spans":841,"direction":79},"rendez-vous ne sont pas compris dans les",[],{"type":216,"text":843,"spans":844,"direction":79},"tarifs des prestations. Le Prestataire peut",[],{"type":216,"text":846,"spans":847,"direction":79},"toutefois, dans la limite des places",[],{"type":216,"text":849,"spans":850,"direction":79},"disponibles dans son véhicule, proposer",[],{"type":216,"text":852,"spans":853,"direction":79},"de transporter Le Client à titre gracieux.",[],{"type":216,"text":855,"spans":856,"direction":79},"Article 17 : Risques",[857],{"start":28,"end":858,"type":221},20,{"type":216,"text":860,"spans":861,"direction":79},"Les risque acceptés par Le Client liés à la",[],{"type":216,"text":863,"spans":864,"direction":79},"pratique de la randonnée à pied ou en",[],{"type":216,"text":866,"spans":867,"direction":79},"bateau en milieu amazonien sont",[],{"type":216,"text":869,"spans":870,"direction":79},"notamment les suivants :",[],{"type":872,"text":873,"spans":874,"direction":79},"list-item","chutes de plantes épiphytes, de",[],{"type":216,"text":876,"spans":877,"direction":79},"branches ou d’arbres pouvant",[],{"type":216,"text":879,"spans":880,"direction":79},"entraîner des blessures ou la mort.",[],{"type":872,"text":882,"spans":883,"direction":79},"piqûres et morsures d’animaux",[],{"type":216,"text":885,"spans":886,"direction":79},"(arthropodes, serpents, poissons,",[],{"type":216,"text":888,"spans":889,"direction":79},"…) parfois venimeux ou mortels.",[],{"type":872,"text":891,"spans":892,"direction":79},"contamination et maladies graves",[],{"type":216,"text":894,"spans":895,"direction":79},"ou mortelles par parasites,",[],{"type":216,"text":897,"spans":898,"direction":79},"protozoaires (paludisme), virus",[],{"type":216,"text":900,"spans":901,"direction":79},"(dengue, fièvre jaune…) ou",[],{"type":216,"text":903,"spans":904,"direction":79},"bactéries.",[],{"type":872,"text":906,"spans":907,"direction":79},"égratignures et\u002Fou blessures par",[],{"type":216,"text":909,"spans":910,"direction":79},"feuilles branches ou rochers lors",[],{"type":216,"text":912,"spans":913,"direction":79},"des randonnées à pied sur et hors",[],{"type":216,"text":915,"spans":916,"direction":79},"sentier et lors des navigations.",[],{"type":872,"text":918,"spans":919,"direction":79},"intoxication mortelle en cas de",[],{"type":216,"text":921,"spans":922,"direction":79},"consommation d’animaux, de",[],{"type":216,"text":924,"spans":925,"direction":79},"graines, de fruits ou de plantes du",[],{"type":216,"text":927,"spans":928,"direction":79},"milieu naturel.",[],{"type":872,"text":930,"spans":931,"direction":79},"chutes et blessures parfois graves",[],{"type":216,"text":933,"spans":934,"direction":79},"ou mortelles sur des terrains ou",[],{"type":216,"text":936,"spans":937,"direction":79},"roches accidentés et\u002Fou glissants",[],{"type":216,"text":939,"spans":940,"direction":79},"ou sur des pointes de bois acérés.",[],{"type":872,"text":942,"spans":943,"direction":79},"chute à l’eau et\u002Fou noyade mortelle",[],{"type":216,"text":945,"spans":946,"direction":79},"lors des navigations et\u002Fou en cas",[],{"type":216,"text":948,"spans":949,"direction":79},"de naufrage, collision avec une",[],{"type":216,"text":951,"spans":952,"direction":79},"autre embarcation ou autre",[],{"type":216,"text":954,"spans":955,"direction":79},"obstacle.",[],{"type":872,"text":957,"spans":958,"direction":79},"chavirement de la pirogue et",[],{"type":216,"text":960,"spans":961,"direction":79},"noyade en navigation ou dans les",[],{"type":216,"text":963,"spans":964,"direction":79},"passages de sauts.",[],{"type":872,"text":966,"spans":967,"direction":79},"noyade en cas de baignade.",[],{"type":872,"text":969,"spans":970,"direction":79},"perte de matériel (appareil photo,",[],{"type":216,"text":972,"spans":973,"direction":79},"téléphones, lunettes, jumelles,",[],{"type":216,"text":975,"spans":976,"direction":79},"bijoux, gps…) et\u002Fou d’autres effets",[],{"type":216,"text":978,"spans":979,"direction":79},"personnels.",[],{"type":872,"text":981,"spans":982,"direction":79},"ampoules et mycoses aux pieds ou",[],{"type":216,"text":984,"spans":985,"direction":79},"ailleurs.",[],{"type":872,"text":987,"spans":988,"direction":79},"chute du hamac ou rupture de",[],{"type":216,"text":990,"spans":991,"direction":79},"carbet pouvant entraîner des",[],{"type":216,"text":993,"spans":994,"direction":79},"blessures voir être mortelle.",[],{"type":872,"text":996,"spans":997,"direction":79},"rencontrer et d’affronter des",[],{"type":216,"text":999,"spans":1000,"direction":79},"inondations, à tout moment.",[],{"type":872,"text":1002,"spans":1003,"direction":79},"être mouillé et sale lors des sorties",[],{"type":216,"text":1005,"spans":1006,"direction":79},"(de la tête aux pieds), mais",[],{"type":216,"text":1008,"spans":1009,"direction":79},"rarement mortel.",[],{"type":872,"text":1011,"spans":1012,"direction":79},"insolation",[],{"type":216,"text":1014,"spans":1015,"direction":79},"Article 18 : Responsabilité",[1016],{"start":28,"end":1017,"type":221},27,{"type":216,"text":1019,"spans":1020,"direction":79},"Le Prestataire s’engage à exécuter les",[],{"type":216,"text":1022,"spans":1023,"direction":79},"services en conformité avec ce qui a été",[],{"type":216,"text":1025,"spans":1026,"direction":79},"convenu. Il ne pourra pas être tenu",[],{"type":216,"text":1028,"spans":1029,"direction":79},"responsable des dommages imputables",[],{"type":216,"text":1031,"spans":1032,"direction":79},"soit au Client, soit à un tiers étranger à la",[],{"type":216,"text":1034,"spans":1035,"direction":79},"fourniture des services compris dans la",[],{"type":216,"text":1037,"spans":1038,"direction":79},"prestation, soit à des circonstances",[],{"type":216,"text":1040,"spans":1041,"direction":79},"exceptionnelles et inévitables. La",[],{"type":216,"text":1043,"spans":1044,"direction":79},"responsabilité du Prestataire ne pourra en",[],{"type":216,"text":1046,"spans":1047,"direction":79},"aucun cas être engagée pour des",[],{"type":216,"text":1049,"spans":1050,"direction":79},"dommages indirects. Sauf préjudices",[],{"type":216,"text":1052,"spans":1053,"direction":79},"corporels ou dommages causés",[],{"type":216,"text":1055,"spans":1056,"direction":79},"intentionnellement, les dommages et",[],{"type":216,"text":1058,"spans":1059,"direction":79},"intérêts qui seraient versés par le",[],{"type":216,"text":1061,"spans":1062,"direction":79},"Prestataire ne pourront pas excéder trois",[],{"type":216,"text":1064,"spans":1065,"direction":79},"fois le prix séjour payé par le Client. Il est",[],{"type":216,"text":1067,"spans":1068,"direction":79},"de la responsabilité du Client de respecter",[],{"type":216,"text":1070,"spans":1071,"direction":79},"toutes les règles et consignes de sécurité.",[],{"type":216,"text":1073,"spans":1074,"direction":79},"Le Client se doit de faire preuve de bon",[],{"type":216,"text":1076,"spans":1077,"direction":79},"sens, de prudence et de précaution lors",[],{"type":216,"text":1079,"spans":1080,"direction":79},"des activités auxquelles il participe.",[],{"type":216,"text":1082,"spans":1083,"direction":79},"Article 19 : Force Majeur",[1084],{"start":28,"end":1085,"type":221},25,{"type":216,"text":1087,"spans":1088,"direction":79},"Le Prestataire ne pourra être tenu",[],{"type":216,"text":1090,"spans":1091,"direction":79},"responsable de l’inexécution totale ou",[],{"type":216,"text":1093,"spans":1094,"direction":79},"partielle de ses obligations contractuelles",[],{"type":216,"text":1096,"spans":1097,"direction":79},"si celle-ci est due à un événement de",[],{"type":216,"text":1099,"spans":1100,"direction":79},"force majeure. Par force majeure, on",[],{"type":216,"text":1102,"spans":1103,"direction":79},"entend tout événement extérieur,",[],{"type":216,"text":1105,"spans":1106,"direction":79},"imprévisible et irrésistible, tel que défini",[],{"type":216,"text":1108,"spans":1109,"direction":79},"par l’article 1218 du Code civil, rendant",[],{"type":216,"text":1111,"spans":1112,"direction":79},"impossible l’exécution du contrat,",[],{"type":216,"text":1114,"spans":1115,"direction":79},"notamment mais sans s’y limiter :",[],{"type":216,"text":1117,"spans":1118,"direction":79},"catastrophes naturelles, pandémies, actes",[],{"type":216,"text":1120,"spans":1121,"direction":79},"de terrorisme, grèves, interruptions des",[],{"type":216,"text":1123,"spans":1124,"direction":79},"moyens de transport, ou toute autre",[],{"type":216,"text":1126,"spans":1127,"direction":79},"circonstance échappant au contrôle",[],{"type":216,"text":1129,"spans":1130,"direction":79},"raisonnable du Prestataire. En cas de",[],{"type":216,"text":1132,"spans":1133,"direction":79},"survenance d’un événement de force",[],{"type":216,"text":1135,"spans":1136,"direction":79},"majeure, le Prestataire en informera le",[],{"type":216,"text":1138,"spans":1139,"direction":79},"client dans les meilleurs délais. Les parties",[],{"type":216,"text":1141,"spans":1142,"direction":79},"conviendront des modalités adaptées pour",[],{"type":216,"text":1144,"spans":1145,"direction":79},"la poursuite, la suspension ou la résiliation",[],{"type":216,"text":1147,"spans":1148,"direction":79},"du contrat, sans que cela ne donne droit à",[],{"type":216,"text":1150,"spans":1151,"direction":79},"une quelconque indemnisation du Client.",[],{"type":216,"text":1153,"spans":1154,"direction":79},"Article 20 : Loi applicable, réclamations et",[1155],{"start":28,"end":1156,"type":221},44,{"type":216,"text":1158,"spans":1159,"direction":79},"litiges",[1160],{"start":28,"end":1161,"type":221},7,{"type":216,"text":1163,"spans":1164,"direction":79},"Le contrat est soumis au droit français. En",[],{"type":216,"text":1166,"spans":1167,"direction":79},"cas de litiges qui ne seraient pas réglés à",[],{"type":216,"text":1169,"spans":1170,"direction":79},"l’amiable, compétence est donnée aux",[],{"type":216,"text":1172,"spans":1173,"direction":79},"tribunaux du ressort du siège social du",[],{"type":216,"text":562,"spans":1175,"direction":79},[],"text$e259d770-33ee-4179-9abe-63469c23c155","text",{},1778139278613]