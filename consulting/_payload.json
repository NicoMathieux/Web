mathieux.cdn.prismic.io\u002Fapi\u002Fv2\u002Fdocuments\u002Fsearch?ref=afqBqBAAACIAYuAP&q=%5B%5B%3Ad+%3D+at%28document.id%2C+%22aD8JWRIAACEA6uti%22%29+%5D%5D",[],[184],[],[],{"slices":211,"meta_title":190,"meta_description":5,"meta_image":409},[212,222,252,290,312,376,385],{"variation":164,"version":165,"items":213,"primary":214,"id":220,"slice_type":221,"slice_label":5},[],{"title":5,"text":215,"shop_related":18},[216],{"type":217,"text":218,"spans":219,"direction":79},"paragraph","Rencontrer, échanger, accompagner : trois façons de créer du lien.",[],"full_width_text$4bd35544-5f51-40d1-ab49-15b9ad2b9b4e","full_width_text",{"variation":164,"version":165,"items":223,"primary":224,"id":250,"slice_type":251,"slice_label":5},[],{"title":225,"subtitle":226,"text":227,"link":240,"image":242,"image_place":5,"image_date":5,"inverted":18,"shop_related":18},"Média - Press","01",[228,231,234,237],{"type":217,"text":229,"spans":230,"direction":79},"Nico répond toujours présent quand il s’agit de partager son parcours et ses idées. ",[],{"type":217,"text":232,"spans":233,"direction":79},"Entre passion, spontanéité et bonne humeur, il aborde chaque rencontre média comme un moment d’échange simple et vrai. ",[],{"type":217,"text":235,"spans":236,"direction":79},"Sur un plateau, en podcast ou dans la presse, il parle de ses expéditions, de la beauté de la nature et du dépassement de soi avec la même énergie que lorsqu'il est sur le terrain. ",[],{"type":217,"text":238,"spans":239,"direction":79},"",[],{"link_type":241},"Any",{"dimensions":243,"alt":246,"copyright":5,"url":247,"id":248,"edit":249},{"width":244,"height":245},4591,3061,"popcorn twitch - domingo","https:\u002F\u002Fimages.prismic.io\u002Fnico-mathieux\u002FaRC27bpReVYa4ROY_WhatsAppImage2025-11-09at12.24.08-2-.jpeg?auto=format,compress","aRC27bpReVYa4ROY",{"x":28,"y":28,"zoom":29,"background":30},"title_text_image$be0c1725-781f-418e-a982-fb9259d9b8b4","title_text_image",{"variation":253,"version":165,"items":254,"primary":255,"id":289,"slice_type":251,"slice_label":5},"withCarousel",[],{"title":256,"subtitle":257,"text":258,"link":271,"element":272,"inverted":91,"shop_related":18},"Consulting - Logistique","02",[259,262,265,268],{"type":217,"text":260,"spans":261,"direction":79},"Préparer une expédition ou un tournage, c’est aussi une sacrée aventure. ",[],{"type":217,"text":263,"spans":264,"direction":79},"Nico et son équipe accompagnent celles et ceux qui veulent créer, explorer ou produire en dehors des sentiers battus. ",[],{"type":217,"text":266,"spans":267,"direction":79},"Un savoir-faire bientôt réuni au sein d’une agence d’expédition dédiée.  ",[],{"type":217,"text":269,"spans":270,"direction":79},"Un projet en cours qui sera taillé pour les nouveaux explorateurs de demain ! ",[],{"link_type":241},[273,281],{"image":274,"place":5,"date":5},{"dimensions":275,"alt":5,"copyright":5,"url":278,"id":279,"edit":280},{"width":276,"height":277},2047,1365,"https:\u002F\u002Fimages.prismic.io\u002Fnico-mathieux\u002FZ_65XOvxEdbNPF_w_e1dd560b721d4901759ac370604944a5.jpeg?auto=format,compress","Z_65XOvxEdbNPF_w",{"x":28,"y":28,"zoom":29,"background":30},{"image":282,"place":5,"date":5},{"dimensions":283,"alt":5,"copyright":5,"url":286,"id":287,"edit":288},{"width":284,"height":285},1463,2048,"https:\u002F\u002Fimages.prismic.io\u002Fnico-mathieux\u002FZ_61UOvxEdbNPF7z_eb849e782154e574f649e18f6e80bcea.jpeg?auto=format,compress","Z_61UOvxEdbNPF7z",{"x":28,"y":28,"zoom":29,"background":30},"title_text_image$87710075-09b3-44db-9ab5-0913f0096421",{"variation":164,"version":165,"items":291,"primary":292,"id":311,"slice_type":251,"slice_label":5},[],{"title":293,"subtitle":294,"text":295,"link":302,"image":303,"image_place":5,"image_date":5,"inverted":18,"shop_related":18},"Conférences","03",[296,299],{"type":217,"text":297,"spans":298,"direction":79},"Plus qu’un récit d’aventure, Nico propose une plongée dans l’humain : le courage, la cohésion, la prise de décision quand tout peut basculer. ",[],{"type":217,"text":300,"spans":301,"direction":79},"Des moments forts, inspirants, qui résonnent particulièrement auprès des équipes, des marques et des entreprises en quête de sens et de souffle.",[],{"link_type":241},{"dimensions":304,"alt":307,"copyright":5,"url":308,"id":309,"edit":310},{"width":305,"height":306},1440,1796,"Grand Rex - Nico Mathieux - juin 2024","https:\u002F\u002Fimages.prismic.io\u002Fnico-mathieux\u002FZ_62L-vxEdbNPF8s_47f6de04bc05cd4a6620c308b81a5654.png?auto=format,compress","Z_62L-vxEdbNPF8s",{"x":28,"y":28,"zoom":29,"background":30},"title_text_image$61c766cb-b89a-4d25-8612-26c09d2c9997",{"variation":313,"version":165,"items":314,"primary":315,"id":374,"slice_type":375,"slice_label":5},"triple",[],{"title":316,"subtitle":294,"left":317,"center":336,"right":354,"shop_related":18},"Dernières apparutions",[318],{"image":319,"title":327,"text":328,"link":332},{"dimensions":320,"alt":323,"copyright":5,"url":324,"id":325,"edit":326},{"width":321,"height":322},522,820,"Interlude Nico Mathieux explorateur Guyane 2025","https:\u002F\u002Fimages.prismic.io\u002Fnico-mathieux\u002FaQ9727pReVYa4Q9F_InterludeNicoMathieuxexplorateuramazonie.png?auto=format,compress","aQ9727pReVYa4Q9F",{"x":28,"y":28,"zoom":29,"background":30},"Interlude",[329],{"type":217,"text":330,"spans":331,"direction":79},"Anecdotes, souvenirs... un vrai moment de partage sur le compte du média Interlude.",[],{"link_type":32,"key":333,"url":334,"target":35,"text":335},"6f29be43-b8bc-4f11-9eae-909b789a3a5c","https:\u002F\u002Fwww.instagram.com\u002Freel\u002FDP_qBiXjGnS\u002F","Regarder",[337],{"image":338,"title":346,"text":347,"link":351},{"dimensions":339,"alt":342,"copyright":5,"url":343,"id":344,"edit":345},{"width":340,"height":341},4096,5120,"Juin 2024- popcorn - domingo -twitch-nicomathieux","https:\u002F\u002Fimages.prismic.io\u002Fnico-mathieux\u002FaRCzsLpReVYa4RN2_WhatsAppImage2025-11-09at12.13.13.jpeg?auto=format,compress","aRCzsLpReVYa4RN2",{"x":28,"y":28,"zoom":29,"background":30},"PopCorn",[348],{"type":217,"text":349,"spans":350,"direction":79},"De retour sur le mythique plateau Twitch, accueilli par la fine équipe de Domingo, Nico parle de l'avant première de son film Taï au Grand Rex. ",[],{"link_type":32,"key":352,"url":353,"target":35,"text":335},"1e358578-84e5-4182-891b-6869333810f5","https:\u002F\u002Fwww.youtube.com\u002Fwatch?v=QUpEfgRtPzM",[355],{"image":356,"title":363,"text":364,"link":371},{"dimensions":357,"alt":5,"copyright":5,"url":360,"id":361,"edit":362},{"width":358,"height":359},2006,1650,"https:\u002F\u002Fimages.prismic.io\u002Fnico-mathieux\u002FaRC4lbpReVYa4RO5_Captured%E2%80%99e%CC%81cran2025-11-09a%CC%8016.51.31.png?auto=format,compress","aRC4lbpReVYa4RO5",{"x":28,"y":28,"zoom":29,"background":30},"Dans le vestiaire",[365,368],{"type":217,"text":366,"spans":367,"direction":79},"Dans les saisons précédentes, des noms tels qu'Orelsan ou encore Oxmo Puccino ont ouvert leurs dressings. ",[],{"type":217,"text":369,"spans":370,"direction":79},"Et pour cette reprise, ils ont choisi Nico pour parcourir avec lui son sac à dos d'expédition.",[],{"link_type":32,"key":372,"url":373,"target":35,"text":335},"b493add9-4088-4948-974b-7b37b87771a8","https:\u002F\u002Fbonnegueule.fr\u002Fblogs\u002Fmedias\u002Fmode-dans-vestiaire-nico-mathieux-explorateur-youtubeur?srsltid=AfmBOorvUijKVLtxo6VSzI1FqOp3GhpQxCWTa7AkgDMjcN_IBbqsF7n9","double_image_link$ee124c14-7634-443a-bfcb-568748bbe2cc","double_image_link",{"variation":164,"version":165,"items":377,"primary":378,"id":384,"slice_type":221,"slice_label":5},[],{"title":379,"text":380,"shop_related":18},"Contactez-nous",[381],{"type":217,"text":382,"spans":383,"direction":79},"Pour toute demande de presse, conférence, collaboration, n'hésitez pas !",[],"full_width_text$5202a237-92fc-4b02-9143-479a380d39a5",{"variation":164,"version":165,"items":386,"primary":387,"id":407,"slice_type":408,"slice_label":5},[],{"categories":388,"image":402,"shop_related":18},[389,391,39